#!/bin/sh
# Start the local Shortlink server in the background.
set -eu

ROOT=$(CDPATH= cd -- "$(dirname "$0")/.." && pwd)
RUN_DIR="$ROOT/.shortlink"
PID_FILE="$RUN_DIR/dev.pid"
LOG_FILE="$RUN_DIR/dev.log"
PORT="${PORT:-8000}"

if [ -x "$ROOT/.venv/bin/python" ]; then
  PYTHON="$ROOT/.venv/bin/python"
else
  PYTHON=python3
fi

mkdir -p "$RUN_DIR"

server_pid() {
  if [ ! -f "$PID_FILE" ]; then
    return 1
  fi
  pid=$(tr -d '[:space:]' < "$PID_FILE")
  [ -n "$pid" ] || return 1
  kill -0 "$pid" 2>/dev/null || return 1
  cmd=$(ps -p "$pid" -o command= 2>/dev/null || true)
  case "$cmd" in
    *devserver*)
      printf '%s\n' "$pid"
      return 0
      ;;
  esac
  if lsof -nP -iTCP:"$PORT" -sTCP:LISTEN -p "$pid" >/dev/null 2>&1; then
    printf '%s\n' "$pid"
    return 0
  fi
  return 1
}

if pid=$(server_pid); then
  echo "Shortlink is already running at http://127.0.0.1:${PORT} (pid ${pid})"
  exit 0
fi
rm -f "$PID_FILE"

if lsof -nP -iTCP:"$PORT" -sTCP:LISTEN >/dev/null 2>&1; then
  echo "Port ${PORT} is already in use. Stop that process, or run: PORT=8001 scripts/up" >&2
  exit 1
fi

cd "$ROOT"
PYTHONPATH=backend PYTHONDONTWRITEBYTECODE=1 PORT="$PORT" \
  nohup "$PYTHON" -m devserver >>"$LOG_FILE" 2>&1 &
echo $! > "$PID_FILE"
pid=$(tr -d '[:space:]' < "$PID_FILE")

i=0
while [ "$i" -lt 50 ]; do
  if ! kill -0 "$pid" 2>/dev/null; then
    echo "The dev server exited before it could listen. Last log lines:" >&2
    tail -n 30 "$LOG_FILE" >&2 || true
    rm -f "$PID_FILE"
    exit 1
  fi
  if lsof -nP -iTCP:"$PORT" -sTCP:LISTEN -p "$pid" >/dev/null 2>&1; then
    echo "Shortlink dev server at http://127.0.0.1:${PORT} (pid ${pid})"
    echo "Log: .shortlink/dev.log"
    exit 0
  fi
  i=$((i + 1))
  sleep 0.1
done

echo "Started pid ${pid}, but port ${PORT} did not open. See .shortlink/dev.log" >&2
exit 1
